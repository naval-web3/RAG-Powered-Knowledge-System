# ====================================================================
# RAG Powered Knowledge System - Backend Environment Configuration
# Copy this file to ".env" and fill in real values. NEVER commit .env.
# ====================================================================

# ---- Application ----
APP_NAME=RAG Powered Knowledge System
ENVIRONMENT=development
DEBUG=true

# ---- Security / JWT ----
# Generate a strong random secret, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret
# The access token is short because a signed JWT cannot be withdrawn: sign-out
# and password changes only bite once it expires. Sessions survive that by
# renewing at POST /api/auth/refresh, so a session lasts REFRESH_TOKEN_EXPIRE_DAYS
# of use, not ACCESS_TOKEN_EXPIRE_MINUTES.
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_knowledge

# ---- Vector store (ChromaDB - embedded/persistent) ----
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=knowledge_base

# ---- File storage ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# Uploaded documents are encrypted on disk with AES-256-GCM. Leave this on
# unless you have a reason not to: with it off, anyone who can open the uploads
# folder can read every document in it.
ENCRYPT_UPLOADS=true

# The key. Left empty, it is derived from SECRET_KEY above, which is one less
# secret to manage but means that changing SECRET_KEY also makes stored
# documents unreadable. Set your own here if you expect to rotate the signing
# key on its own:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Whichever you use, losing it loses the documents. Keep a copy somewhere the
# backup archive is not.
FILE_ENCRYPTION_KEY=

# ---- RAG tuning ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5

# ---- OCR (scanned / image-only PDFs) ----
# When a PDF page has no selectable text, fall back to OCR (render the page and
# read it with RapidOCR). Set OCR_ENABLED=false to reject scanned PDFs instead.
# OCR runs on CPU and is slow (~seconds per page).
OCR_ENABLED=true
OCR_DPI=240
OCR_MAX_PAGES=30

# ---- LLM provider / generation limits ----
# Hard timeout (seconds) on one LLM generation, and a cap on generated tokens.
# Prevents a model too large for the GPU from making chat hang forever.
LLM_TIMEOUT=90
LLM_MAX_TOKENS=512

# ---- LLM provider selection ----
# Default provider: "ollama" (local, free) or "openai" (cloud, needs key)
DEFAULT_LLM_PROVIDER=ollama

# ---- Ollama (local) ----
OLLAMA_BASE_URL=http://localhost:11434
# A ~2GB model stays fully resident on a 4GB GPU and answers fast.
OLLAMA_MODEL=llama3.2:3b

# ---- OpenAI (cloud) ----
# Paste your key here in the REAL .env file (not this example file).
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Embedding selection ----
# "local"  -> sentence-transformers (free, 384 dims)
# "openai" -> OpenAI embeddings (needs key, 1536 dims)
EMBEDDING_BACKEND=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- CORS ----
FRONTEND_ORIGIN=http://localhost:5173
